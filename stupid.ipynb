   "source": [
    "import math\n",
    "\n",
    "\n",
    "def pascal_triangle(n, k):\n",
    "    return math.factorial(n) // (math.factorial(k) * math.factorial(n - k))\n",
    "\n",
    "\n",
    "print(pascal_triangle(13, 5) * 2 ** 5)"
   ]
  }
 ],
